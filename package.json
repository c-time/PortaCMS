{
  "name": "porta-cms",
  "version": "1.0.0",
  "private": true,
  "description": "PortaCMS - A portable, API-first content management system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-time/PortaCMS.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/c-time/PortaCMS/issues"
  },
  "homepage": "https://github.com/c-time/PortaCMS#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=@porta-cms/core",
    "dev": "npm run dev --workspaces",
    "watch": "npm run watch --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
